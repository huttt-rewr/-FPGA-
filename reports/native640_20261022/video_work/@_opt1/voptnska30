library verilog;
use verilog.vl_types.all;
entity rgb_lerp_pipeline is
    port(
        clk             : in     vl_logic;
        rst             : in     vl_logic;
        a               : in     vl_logic_vector(23 downto 0);
        b               : in     vl_logic_vector(23 downto 0);
        fraction        : in     vl_logic_vector(7 downto 0);
        result          : out    vl_logic_vector(23 downto 0)
    );
end rgb_lerp_pipeline;
